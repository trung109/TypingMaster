<UserControl x:Class="TypingMaster.Views.VirtualKeyboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Standard Key Style -->
        <Style x:Key="KeyStyle" TargetType="Border">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="LeftPinky">
                    <Setter Property="Background" Value="#FFB3BA"/>
                </Trigger>
                <Trigger Property="Tag" Value="LeftRing">
                    <Setter Property="Background" Value="#BAE1FF"/>
                </Trigger>
                <Trigger Property="Tag" Value="LeftMiddle">
                    <Setter Property="Background" Value="#FFFFBA"/>
                </Trigger>
                <Trigger Property="Tag" Value="LeftIndex">
                    <Setter Property="Background" Value="#BAFFC9"/>
                </Trigger>
                <Trigger Property="Tag" Value="RightIndex">
                    <Setter Property="Background" Value="#BAFFC9"/>
                </Trigger>
                <Trigger Property="Tag" Value="RightMiddle">
                    <Setter Property="Background" Value="#FFFFBA"/>
                </Trigger>
                <Trigger Property="Tag" Value="RightRing">
                    <Setter Property="Background" Value="#BAE1FF"/>
                </Trigger>
                <Trigger Property="Tag" Value="RightPinky">
                    <Setter Property="Background" Value="#FFB3BA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modifier Key Style -->
        <Style x:Key="ModifierKeyStyle" TargetType="Border">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="#D0D0D0"/>
        </Style>

        <!-- Center text style -->
        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Small corner text style -->
        <Style x:Key="CornerText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="4,2,0,0"/>
            <Setter Property="Foreground" Value="#666"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Number Row (Total: ~818px) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
            <!-- Each number key with symbol in corner -->
            <Border Style="{StaticResource KeyStyle}" Tag="LeftPinky">
                <Grid>
                    <TextBlock Text="~" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="`" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftPinky">
                <Grid>
                    <TextBlock Text="!" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="1" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftRing">
                <Grid>
                    <TextBlock Text="@" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="2" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftMiddle">
                <Grid>
                    <TextBlock Text="#" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="3" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftIndex">
                <Grid>
                    <TextBlock Text="$" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="4" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftIndex">
                <Grid>
                    <TextBlock Text="%" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="5" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightIndex">
                <Grid>
                    <TextBlock Text="^" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="6" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightIndex">
                <Grid>
                    <TextBlock Text="&amp;" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="7" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightMiddle">
                <Grid>
                    <TextBlock Text="*" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="8" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightRing">
                <Grid>
                    <TextBlock Text="(" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="9" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightPinky">
                <Grid>
                    <TextBlock Text=")" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="0" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightPinky">
                <Grid>
                    <TextBlock Text="_" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="-" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightPinky">
                <Grid>
                    <TextBlock Text="+" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="=" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource ModifierKeyStyle}" Width="94">
                <TextBlock Text="Backspace" FontSize="11" FontWeight="Bold"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <!-- Row 1: Q Row (Total: ~818px) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
            <Border Style="{StaticResource ModifierKeyStyle}" Width="75">
                <TextBlock Text="Tab" Style="{StaticResource CenterText}" FontSize="12"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftPinky">
                <TextBlock Text="Q" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftRing">
                <TextBlock Text="W" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftMiddle">
                <TextBlock Text="E" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftIndex">
                <TextBlock Text="R" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftIndex">
                <TextBlock Text="T" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightIndex">
                <TextBlock Text="Y" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightIndex">
                <TextBlock Text="U" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightMiddle">
                <TextBlock Text="I" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightRing">
                <TextBlock Text="O" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightPinky">
                <TextBlock Text="P" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightPinky">
                <Grid>
                    <TextBlock Text="{}{" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="[" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightPinky">
                <Grid>
                    <TextBlock Text="}" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="]" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightPinky" Width="70">
                <Grid>
                    <TextBlock Text="|" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="\" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Row 2: A Row (Total: ~818px) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
            <Border Style="{StaticResource ModifierKeyStyle}" Width="91">
                <TextBlock Text="Caps Lock" FontSize="10" FontWeight="Bold"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftPinky">
                <TextBlock Text="A" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftRing">
                <TextBlock Text="S" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftMiddle">
                <TextBlock Text="D" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftIndex">
                <TextBlock Text="F" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftIndex">
                <TextBlock Text="G" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightIndex">
                <TextBlock Text="H" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightIndex">
                <TextBlock Text="J" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightMiddle">
                <TextBlock Text="K" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightRing">
                <TextBlock Text="L" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightPinky">
                <Grid>
                    <TextBlock Text=":" Style="{StaticResource CornerText}"/>
                    <TextBlock Text=";" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightPinky">
                <Grid>
                    <TextBlock Text="&quot;" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="'" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource ModifierKeyStyle}" Width="107">
                <TextBlock Text="Enter" Style="{StaticResource CenterText}" FontSize="12"/>
            </Border>
        </StackPanel>

        <!-- Row 3: Z Row (Total: ~818px) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
            <Border Style="{StaticResource ModifierKeyStyle}" Width="126">
                <TextBlock Text="Shift" Style="{StaticResource CenterText}" FontSize="12"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftPinky">
                <TextBlock Text="Z" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftRing">
                <TextBlock Text="X" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftMiddle">
                <TextBlock Text="C" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftIndex">
                <TextBlock Text="V" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="LeftIndex">
                <TextBlock Text="B" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightIndex">
                <TextBlock Text="N" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightIndex">
                <TextBlock Text="M" Style="{StaticResource CenterText}"/>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightMiddle">
                <Grid>
                    <TextBlock Text="&lt;" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="," Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightRing">
                <Grid>
                    <TextBlock Text="&gt;" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="." Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource KeyStyle}" Tag="RightPinky">
                <Grid>
                    <TextBlock Text="?" Style="{StaticResource CornerText}"/>
                    <TextBlock Text="/" Style="{StaticResource CenterText}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource ModifierKeyStyle}" Width="126">
                <TextBlock Text="Shift" Style="{StaticResource CenterText}" FontSize="12"/>
            </Border>
        </StackPanel>

        <!-- Row 4: Space Bar -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
            <Border Width="320" Height="50" Background="#E0E0E0" 
                    BorderBrush="Gray" BorderThickness="2" 
                    CornerRadius="5" Margin="2">
                <TextBlock Text="SPACE" FontSize="14" FontWeight="Bold"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="#666"/>
            </Border>
        </StackPanel>
    </Grid>

</UserControl>