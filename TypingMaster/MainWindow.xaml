<Window x:Class="TypingMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:TypingMaster.Helpers"
        Title="TypingMaster" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Session"/>
                <MenuItem Header="_Save Progress"/>
                <Separator/>
                <MenuItem Header="_Settings"/>
                <Separator/>
                <MenuItem Header="E_xit"/>
            </MenuItem>

            <MenuItem Header="_Practice">
                <MenuItem Header="_Start Practice"/>
                <MenuItem Header="Select _Lesson"/>
                <MenuItem Header="Select _Mode"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Show/Hide _Keyboard" IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="Show/Hide _Lesson Info" IsCheckable="True" IsChecked="True"/>
                <MenuItem Header="_Fullscreen"/>
            </MenuItem>

            <MenuItem Header="_Statistics">
                <MenuItem Header="View _Progress"/>
                <MenuItem Header="_Recent Sessions"/>
                <MenuItem Header="_Export Data"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_Tutorial"/>
                <MenuItem Header="_About"/>
            </MenuItem>
        </Menu>

        <!-- Main Content Area -->
        <!-- Main Content Area -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Lesson selector + Timer -->
                <RowDefinition Height="Auto"/>
                <!-- Lesson info + Mode selection -->
                <RowDefinition Height="2*"/>
                <!-- Text display -->
                <RowDefinition Height="3*"/>
                <!-- Virtual keyboard -->
                <RowDefinition Height="Auto"/>
                <!-- Stats bar -->
            </Grid.RowDefinitions>

            <!-- Row 0: Lesson Selector and Timer -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Width="300" HorizontalAlignment="Left"
                  SelectedIndex="0">
                    <ComboBoxItem Content="Lesson 1: Home Row (ASDF JKL;)"/>
                    <ComboBoxItem Content="Lesson 2: Top Row (QWER UIOP)"/>
                    <ComboBoxItem Content="Lesson 3: Bottom Row (ZXCV M,.)"/>
                </ComboBox>

                <TextBlock Grid.Column="1" Text="Timer: 00:00" 
                   FontSize="18" FontWeight="Bold"
                   VerticalAlignment="Center"/>
            </Grid>

            <!-- Row 1: Lesson Info + Mode Selection -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Lesson Info (Collapsible) -->
                <Expander Grid.Column="0" Header="Lesson Information" IsExpanded="True">
                    <StackPanel>
                        <Image Source="/Resources/lesson1.png" Height="150" 
                       Stretch="Uniform" Margin="5"
                       HorizontalAlignment="Left"/>
                        <TextBlock Text="Place your fingers on the home row keys. Left hand: A S D F, Right hand: J K L ;" 
                           TextWrapping="Wrap" Margin="5"/>
                    </StackPanel>
                </Expander>

                <!-- Mode Selection -->
                <GroupBox Grid.Column="1" Header="Mode Selection" Margin="10,0,0,0">
                    <StackPanel>
                        <RadioButton Content="Random Characters" IsChecked="True" Margin="5"/>
                        <RadioButton Content="Words/Sentences" Margin="5"/>
                        <RadioButton Content="AI Generated" Margin="5" IsEnabled="False"/>
                        <TextBox Margin="5,10,5,5" 
                         Text="AI Prompt..." 
                         IsEnabled="False"
                         Height="60" 
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <!-- Row 2: Text Display -->
            <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="2" 
                    Padding="15" Margin="0,0,0,10" Background="White">
                <TextBlock helpers:TextBlockHelper.BindableInlines="{Binding FormattedTextInlines}"
                   FontSize="24" FontFamily="Consolas"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
            </Border>

            <!-- Row 3: Virtual Keyboard Placeholder -->
            <Border Grid.Row="3" BorderBrush="LightGray" BorderThickness="1" 
                    Padding="10" Margin="0,0,0,10" Background="#F5F5F5">
                <TextBlock Text="Virtual Keyboard Will Go Here" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   FontSize="16" Foreground="Gray"/>
            </Border>

            <!-- Row 4: Stats Bar -->
            <Border Grid.Row="4" Background="#E0E0E0" Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Wpm, StringFormat='WPM: {0}'}" FontWeight="Bold" Margin="0,0,30,0"/>
                    <TextBlock Text="{Binding Accuracy, StringFormat='Accuracy: {0:F1}%'}" FontWeight="Bold" Margin="0,0,30,0"/>
                    <TextBlock Text="{Binding ErrorCount, StringFormat='Errors: {0}'}" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>

</Window>